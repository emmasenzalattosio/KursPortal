
@model List<Kurs>

<div class="onlycode-courses">

    <h1 class="courses-heading">
        > COURSE_DATABASE.EXE
    </h1>

    <p class="courses-description">
        Choose your suffering. Learn to code.
    </p>

    <a asp-controller="Kurs"
       asp-action="Create"
       class="btn btn-info mb-4">
        + Neuen Kurs erstellen
    </a>

    <div class="row g-4">

        @foreach (var kurs in Model)
        {
            <div class="col-sm-6 col-lg-4">

                <div class="card h-100 text-center">

                    <div class="card-body">

                        <p class="course-teacher">
                            Dozent: @kurs.Dozent
                        </p>

                        <h5 class="card-title">
                            @kurs.KursName
                        </h5>

                        <p class="card-text">
                            Dauer: @kurs.DauerInTagen Tage
                        </p>

                        <a asp-controller="Kurs"
                           asp-action="Detail"
                           asp-route-id="@kurs.ID"
                           class="btn btn-primary">
                            [ DETAILS → ]
                        </a>

                    </div>

                    <div class="card-footer">
                        Teilnehmeranzahl: @kurs.AnzahlTeilnehmer
                    </div>

                </div>

            </div>
        }

    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary mt-4">
        ← Back to Home
    </a>

</div>
